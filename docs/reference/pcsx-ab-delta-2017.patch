--- base/frontend/warm/warm.c	1970-01-01 00:00:00.000000000 +0000
+++ abnorm/frontend/warm/warm.c	2026-09-20 12:51:53.634911900 +0100
@@ -0,0 +1,306 @@
+/*
+ * wARM - exporting ARM processor specific privileged services to userspace
+ * userspace part
+ *
