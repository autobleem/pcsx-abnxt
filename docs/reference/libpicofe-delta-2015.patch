+/* Put a w x h frame (16bpp RGB565 or 24bpp RGB888, pitch w * bpp / 8) on screen: upload it to the
+ * streaming texture and let the renderer scale it. keep_4_3 pillarboxes it to 4:3 in the window (the
+ * -ratio option; the console's GL path does the same by sizing its EGL window 960x720 vs 1280x720),
+ * linear picks the scaling filter (the -filter option, as gl.c does with GL_LINEAR/GL_NEAREST). */
+int plat_sdl_present(const void *fb, int w, int h, int bpp, int keep_4_3, int linear)
+{
+  SDL_Rect dst;
+  int win_w, win_h;
+
+  if (fb == NULL || w <= 0 || h <= 0)
+    return -1;
+  if (plat_sdl_ensure_renderer() != 0)
+    return -1;
+
+  if (sdl2_texture == NULL || sdl2_texture_w != w || sdl2_texture_h != h
+      || sdl2_texture_bpp != bpp || sdl2_texture_linear != linear)
+  {
+    if (sdl2_texture != NULL)
+      SDL_DestroyTexture(sdl2_texture);
+    SDL_SetHint(SDL_HINT_RENDER_SCALE_QUALITY, linear ? "linear" : "nearest");
+    sdl2_texture = SDL_CreateTexture(sdl2_renderer,
+      bpp == 24 ? SDL_PIXELFORMAT_RGB24 : SDL_PIXELFORMAT_RGB565,
+      SDL_TEXTUREACCESS_STREAMING, w, h);
+    if (sdl2_texture == NULL) {
+      fprintf(stderr, "plat_sdl: SDL_CreateTexture %dx%d@%d failed: %s\n", w, h, bpp, SDL_GetError());
+      return -1;
+    }
+    sdl2_texture_w = w;
+    sdl2_texture_h = h;
+    sdl2_texture_bpp = bpp;
+    sdl2_texture_linear = linear;
+  }
+
+  if (SDL_UpdateTexture(sdl2_texture, NULL, fb, w * bpp / 8) != 0) {
+    fprintf(stderr, "plat_sdl: SDL_UpdateTexture failed: %s\n", SDL_GetError());
+    return -1;
+  }
+
+  SDL_GetRendererOutputSize(sdl2_renderer, &win_w, &win_h);
+  if (keep_4_3) {
+    dst.h = win_h;
+    dst.w = win_h * 4 / 3;
+    if (dst.w > win_w) {
+      dst.w = win_w;
+      dst.h = win_w * 3 / 4;
+    }
+  }
+  else {
+    dst.w = win_w;
+    dst.h = win_h;
+  }
+  dst.x = (win_w - dst.w) / 2;
+  dst.y = (win_h - dst.h) / 2;
+
+  SDL_RenderClear(sdl2_renderer);
+  SDL_RenderCopy(sdl2_renderer, sdl2_texture, NULL, &dst);
+  SDL_RenderPresent(sdl2_renderer);
+  return 0;
+}
